{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(cd build:*)",
      "Bash(make:*)",
      "Bash(cd build && make:*)",
      "Bash(rg:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",

      "Read(src/**)",
      "Read(python/**)",
      "Read(tests/**)",
      "Read(build/**)",
      "Read(config/**)",
      "Read(Makefile)",
      "Read(*.md)",

      "Edit(src/turbulence/**)",
      "Edit(src/modules/**)",
      "Edit(src/initFlow/**)",
      "Edit(src/utils/**)",
      "Edit(src/output/**)",
      "Edit(src/NKSolver/**)",
      "Edit(src/solver/**)",
      "Edit(src/preprocessing/**)",
      "Edit(python/**)",
      "Edit(tests/**)",
      "Edit(*.md)",

      "Write(tests/**)",
      "Write(*.md)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(rm:*)",
      "Edit(Makefile)",
      "Edit(config/**)",
      "Edit(.gitignore)",

      "Edit(src/adjoint/outputForward/**)",
      "Edit(src/adjoint/outputReverse/**)",
      "Edit(src/adjoint/outputReverseFast/**)",
      "Edit(src/adjoint/temp_forward/**)",
      "Edit(src/adjoint/temp_reverse/**)",
      "Edit(src/adjoint/temp_reverse_fast/**)",
      "Write(src/adjoint/outputForward/**)",
      "Write(src/adjoint/outputReverse/**)",
      "Write(src/adjoint/outputReverseFast/**)",
      "Write(src/adjoint/temp_forward/**)",
      "Write(src/adjoint/temp_reverse/**)",
      "Write(src/adjoint/temp_reverse_fast/**)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard origin/*)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/credentials*)",
      "Read(**/*secret*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-/home/mdo/MDOLab_3_v2/adflow_sa_gamma_rethetha_paper_solver}/.claude/hooks/guard_protected_files.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-/home/mdo/MDOLab_3_v2/adflow_sa_gamma_rethetha_paper_solver}/.claude/hooks/announce_long_run.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-/home/mdo/MDOLab_3_v2/adflow_sa_gamma_rethetha_paper_solver}/.claude/hooks/auto_pip_after_make.sh\"",
            "timeout": 180,
            "statusMessage": "Installing adflow into mach env (post-make)…"
          }
        ]
      }
    ]
  }
}
